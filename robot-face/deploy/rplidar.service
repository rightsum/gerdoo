[Unit]
Description=RPLIDAR C1 driver + /scan bridge (on demand, started by the control panel)
Documentation=file:///home/jarvis/gerdoo/logs/004-2026-08-04-rplidar-c1-bringup.md

[Service]
Type=simple
ExecStart=%h/robot-face/deploy/run-lidar.sh

# Deliberately NOT Restart=always. The lidar is an on-demand device: if the
# panel stopped it, it must stay stopped, and a start that fails because the
# lidar is unplugged should surface as a failure rather than a restart loop.
Restart=no

# The C1's motor holds its last commanded state: kill the driver uncleanly and
# the lidar spins until someone unplugs it. rclcpp only runs its shutdown
# handler — and therefore setMotorSpeed(0) — on SIGINT, so send that, and give
# run-lidar.sh room to also issue the raw STOP command as a backstop.
KillSignal=SIGINT
TimeoutStopSec=20
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rplidar

# No [Install] section on purpose — this unit must never be enabled at boot.
# The control panel starts it with `systemctl --user start rplidar.service`.
