[Unit]
Description=Video player — one idle mpv that owns the screen when a video plays
After=robot-face.service
Wants=robot-face.service

[Service]
Type=simple
Environment=DISPLAY=:0
# Idle with no window: the kiosk face stays visible until loadfile is sent, and
# stop takes the window away again.
#
# --fullscreen applies to the window when it does appear, so a video always
# covers the face — and it is genuinely fullscreen, no strip reserved.
#
# An earlier arrangement sized this to the screen MINUS a strip so the kiosk
# page's toolbar stayed visible during playback. It worked, but it cost 190px of
# picture and needed the browser dropped out of fullscreen to win the stacking
# fight with xfwm4. The controls are drawn INSIDE mpv instead now
# (mpv-seek.lua), floating over the video at 50% opacity, so the video keeps the
# whole screen and the Wake button is still reachable. See log 025.
ExecStart=/usr/bin/mpv --idle=yes --force-window=no \
    --fullscreen \
    --input-ipc-server=%t/gerdoo-mpv.sock \
    --script-opts=ytdl_hook-ytdl_path=%h/.local/bin/yt-dlp \
    --ytdl-format=bestvideo[height<=1080]+bestaudio/best \
    --no-terminal --no-osc --cursor-autohide=always --keep-open=no \
    --script=%h/robot-face/deploy/mpv-seek.lua
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
