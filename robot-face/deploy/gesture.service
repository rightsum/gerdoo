[Unit]
Description=Hand-gesture detection (MediaPipe) for the control panel — on demand
Documentation=file:///home/jarvis/gerdoo/logs/010-2026-08-04-gesture-detection.md
After=robot-face.service
Wants=robot-face.service

[Service]
Type=simple
# Runs from its OWN virtualenv: MediaPipe needs numpy 2.2 / cv2 5.0, which
# would break the system cv2 4.8 and ROS Humble. Never run this with the
# system python3.
ExecStart=%h/gesture-venv/bin/python %h/robot-face/gesture_detector.py
WorkingDirectory=%h/robot-face

# On demand, like the lidar: started by the control panel, not at boot.
# Restart on failure only — if the panel stopped it, it stays stopped.
Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gesture

# No [Install] section on purpose — this unit must never be enabled at boot.
