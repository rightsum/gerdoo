[Desktop Entry]
Type=Application
Name=Robot Face (kiosk)
Comment=Open the robot face full-screen in Firefox, GPU-accelerated
# Wait for the graphical session + robot-face service, then launch the browser.
# start-kiosk.sh replaces --kiosk with a maximized undecorated window, so the
# video player can float above it and leave the toolbar reachable. See log 025.
Exec=/bin/bash -c "sleep 8 && /home/jarvis/robot-face/deploy/start-kiosk.sh"
X-GNOME-Autostart-enabled=true
X-XFCE-Autostart-enabled=true
Hidden=false
NoDisplay=false
