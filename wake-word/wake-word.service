[Unit]
Description=Wake-word trigger — Persian "Gerdoo, baba" (گردو بابا)
After=pulseaudio.service sound.target

[Service]
Type=simple
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1

# Builds the XVF3800 mono mic source (gerdoo_mic) and pins PulseAudio's
# defaults to it. Resolves cards BY NAME; a USB replug resets mixer levels.
ExecStartPre=-%h/wake-word/audio-setup.sh

# "pulse" = PulseAudio's default source, i.e. gerdoo_mic: XVF3800 channel 0,
# already echo-cancelled. Going through PulseAudio (not raw ALSA) also means
# Firefox and this detector can share the microphone.
# --gain 1.0: channel 0 has the XVF3800's own AGC. The 3.0 used on the Brio
# would clip it.
ExecStart=/usr/bin/python3 %h/wake-word/wake_word.py \
    --device-name pulse \
    --capture-rate 16000 \
    --mode filler \
    --gain 1.0 \
    --threshold 0.5 \
    --cooldown 3.0 \
    --sound %h/wake-word/sounds/janam.mp3 \
    --voice-url http://localhost:8080 \
    --log %h/wake-word/triggers.log \
    --save-hits %h/wake-word/hits \
    --record %h/wake-word/ambient.wav

Restart=always
RestartSec=3

[Install]
WantedBy=default.target
