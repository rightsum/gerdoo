[Unit]
Description=Wake-word trigger — Persian "Gerdoo, baba" (گردو بابا)
After=pulseaudio.service sound.target

[Service]
Type=simple
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1

# The Brio's hardware capture gain does not survive a reboot, and the whole
# reason 4 m worked was getting it to the top of its range. Set it every start.
ExecStartPre=-/usr/bin/amixer -c 2 sset Headset 100%
ExecStartPre=-/usr/bin/pactl set-source-volume alsa_input.usb-046d_Brio_500_2437ZBD0PNK8-02.analog-stereo 100%

# --device-name, not --device: PortAudio indices move between reboots.
# --gain 3.0 was measured, not guessed: replaying a recorded session showed
# 18 hits at 1x and 21 at 3x, with 4x and above losing them again to clipping.
ExecStart=/usr/bin/python3 %h/wake-word/wake_word.py \
    --device-name Brio \
    --mode filler \
    --gain 3.0 \
    --threshold 0.5 \
    --cooldown 3.0 \
    --sound %h/wake-word/sounds/janam.mp3 \
    --log %h/wake-word/triggers.log \
    --save-hits %h/wake-word/hits \
    --record %h/wake-word/ambient.wav

Restart=always
RestartSec=3

[Install]
WantedBy=default.target
