[Unit]
Description=micro-ROS agent — Teensy 4.1 bridge to ROS 2
Documentation=https://github.com/rightsum/gerdoo/blob/main/docs/logs/007-2026-08-04-microros-bringup.md

# There is deliberately no `After=default.target` here.
#
# A unit WantedBy=default.target is already implicitly ordered Before it, so
# also ordering it After the same target closes a loop. Nothing complained —
# but any OTHER service ordered After this one then inherited the cycle, and
# systemd breaks a cycle by deleting a start job. battery-bridge.service was
# the casualty: never started, no error, no journal entry, and the control
# panel's battery bars sat blank for weeks.
#
#   default.target: Found ordering cycle on battery-bridge.service/start
#   Job battery-bridge.service/start deleted to break ordering cycle

[Service]
Type=simple
ExecStart=%h/gerdoo/teensy_microros/deploy/run-agent.sh

# The agent must come back on its own: the Teensy vanishes for ~6s on every
# reflash, and the board may enumerate after this unit starts. The launcher
# waits up to 60s for the device, so a restart here means something real
# happened (device gone, agent crashed), not just a slow boot.
Restart=always
RestartSec=3

# Default KillMode=control-group already reaps the whole cgroup, but the
# launcher execs the agent binary directly so the main PID is the agent
# itself — no wrapper to orphan. See logs/007.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=micro-ros-agent

[Install]
WantedBy=default.target
