# LiveKit — shared with the Jetson's Flask app, which signs join tokens.
# The key pair must match your voice-agent/livekit.yaml (copy it from
# livekit.yaml.example; livekit.yaml is gitignored).
LIVEKIT_URL=ws://mac-studio.local:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs — STT and TTS. Never leaves the Mac.
ELEVEN_API_KEY=

# LiteLLM proxy — OpenAI-compatible. Never leaves the Mac.
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=
# Verified inside a real agent session, not just standalone — a model can
# stream fine over raw HTTP and still return nothing in-session.
#   gemini/gemini-3.5-flash-lite  works
#   gpt-4o-2024-08-06             works
#   glm-5.3:cloud                 works, but burns 300+ reasoning tokens per reply
#   deepseek-v4-flash:0731-cloud  EMPTY replies, with or without the
#                                 ollama_chat/ prefix. Cause not found.
LITELLM_MODEL=gemini/gemini-3.5-flash-lite

# Which ElevenLabs voice speaks. Run `make voices` to list the ids on
# your account. Leave the model multilingual — the turbo and English-only
# models mangle Farsi.
ELEVEN_VOICE_ID=
ELEVEN_TTS_MODEL=eleven_multilingual_v2

# The agent greets the user by this name (optional; personal — keep out of the repo)
AGENT_USER_NAME=
