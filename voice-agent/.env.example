# LiveKit — shared with the Jetson's Flask app, which signs join tokens.
# The key pair must match your voice-agent/livekit.yaml (copy it from
# livekit.yaml.example; livekit.yaml is gitignored).
LIVEKIT_URL=ws://mac-studio.local:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ElevenLabs — STT and TTS. Never leaves the Mac.
ELEVEN_API_KEY=

# LiteLLM proxy — OpenAI-compatible. Never leaves the Mac.
LITELLM_BASE_URL=https://litellm.example.com/v1
LITELLM_API_KEY=
# Verified inside a real agent session, not just standalone — a model can
# stream fine over raw HTTP and still return nothing in-session.
#
# Tool calling was measured directly against the proxy with the real system
# prompt and all four tools, on three cases: "play me a song" must call
# play_video, "what time is it" must call what_time_is_it, and plain chat must
# call nothing. Latency is the average of those three.
#   gemini/gemini-3.8-flash       all three correct, 1.5s
#   gemini/gemini-3.5-flash-lite  all three correct, 0.8s
#   gpt-4.1                       all three correct, 0.7s
#   gpt-5.2                       all three correct, 0.7s
#   glm-5.3-flash:cloud           all three correct, 1.9s
#   glm-5.3:cloud                 all three correct, 4.8s — too slow to talk to
#   gpt-4o-2024-08-06             works
#   deepseek-v4-flash:0731-cloud  EMPTY replies, with or without the
#                                 ollama_chat/ prefix. Cause not found.
#
# ⚠️ Anything beginning `openrouter/` fails with "Missing Authentication header"
# unless an OpenRouter key is configured on the LiteLLM proxy itself. The id
# also needs its provider prefix: bare `gemini-3.8-flash` reports "no healthy
# deployments", while `gemini/gemini-3.8-flash` works.
LITELLM_MODEL=gemini/gemini-3.8-flash

# Which ElevenLabs voice speaks. Run `make voices` to list the ids on
# your account. Leave the model multilingual — the turbo and English-only
# models mangle Farsi.
ELEVEN_VOICE_ID=
ELEVEN_TTS_MODEL=eleven_multilingual_v2

# The agent greets the user by this name (optional; personal — keep out of the repo)
AGENT_USER_NAME=

# Ollama web search, so the agent can answer questions about the outside
# world. Free key from https://ollama.com/settings/keys
# Docs: https://docs.ollama.com/capabilities/web-search
OLLAMA_API_KEY=

# The robot's Flask app, for playing videos on its screen. The token is
# generated on the robot and stored in its gitignored config.json as
# "video_token" — the two must match.
VIDEO_BASE_URL=http://<robot>:8080
VIDEO_API_TOKEN=
